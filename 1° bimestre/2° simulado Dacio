#include <stdio.h>

int main() {
    float preco, vp, pvp;

    // pede os dados de entrada
    printf("Digite o preco da acao (R$): ");
    scanf("%f", &preco);

    printf("Digite o valor patrimonial (VP): ");
    scanf("%f", &vp);

    // calcula o indicador P/VP conforme a formula do quadro
    pvp = vp / (preco * 100);

    printf("\nP/VP calculado: %.2f\n", pvp);
    printf("\nRecomendacoes:\n");

    // cada if e independente - o cliente pode se encaixar em mais de uma
    if (preco > 10.00 && pvp > 0.5) {
        printf("- OTIMA / COMPRA\n");
    }
    if (preco < 4.00 && pvp < 1.0) {
        printf("- REGULAR / ESPERE\n");
    }
    if (preco > 5.00 && pvp < 1.2) {
        printf("- RUIM / NAO COMPRE\n");
    }
    if (preco < 10.00 && pvp > 0.3) {
        printf("- OPORTUNIDADE\n");
    }
    if (preco > 4.00 && pvp < 0.7) {
        printf("- ATENCAO\n");
    }

    return 0;
}
