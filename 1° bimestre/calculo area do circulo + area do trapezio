	//calculo da area do trapezio no mesmo programa
	
	float base_maior, base_menor, altura;
	printf("Insira o valor da base maior do trapezio\n");
	scanf ("%f", &base_maior);
	
	printf("Insira o valor da base menor do trapezio\n");
	scanf ("%f", &base_menor);
	
    printf("Insira o valor da altura do trapezio\n");
