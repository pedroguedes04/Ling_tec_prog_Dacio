#include <stdio.h>

#define TAM 10

int main() {
    int num[TAM], i;

    for (i = 0; i < TAM; i++) {
        printf("Digite o %do numero: ", i + 1);
        while (scanf("%d", &num[i]) != 1) {
            printf("Valor invalido, digite de novo: ");
            while (getchar() != '\n'); // limpa o buffer
        }
    }

    printf("\nOrdem inversa:\n");
    for (i = TAM - 1; i >= 0; i--) {
        printf("%d ", num[i]);
    }
    printf("\n");

    return 0;
}
